Thumbs.db

# -----------------------
# NVIDIA / Isaac Sim heavy caches
# (Uncomment if using Isaac Sim / Omniverse to avoid bloating repo)
# ~/.cache/ov/
# ~/.nvidia-omniverse/
# ~/.local/share/ov/
*.etli

# -----------------------
# data settings
# -----------------------
data/*
!data/README.md
!data/_download.py
!.env.sample

# Industrial task furniture: the converted meshes ARE versioned (via LFS, see
# .gitattributes) so users don't have to re-extract them just to run the task.
# Only the runtime files — *_attach.xml + visual/collision OBJs, ~7 MB. The
# downloaded source USDs stay out: they're only needed to regenerate, and Isaac
# references the originals remotely when rendering.
!data/assets/
data/assets/*
!data/assets/industrial/
data/assets/industrial/*
!data/assets/industrial/TableTrolley_B02_01/
!data/assets/industrial/MobileShelvingCart_C05_01/
data/assets/industrial/*/*.usd

# Sphinx build artifacts
docs/build/
docs/source/api/

# cuRobo build artifacts
third_party/curobo/build/
third_party/curobo/.eggs/
third_party/curobo/*.egg-info/
third_party/curobo/__pycache__/
!third_party

