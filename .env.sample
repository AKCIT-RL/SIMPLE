GPUs=0
TIMEZONE=America/Los_Angeles
TORCH_CUDA_ARCH_LIST=8.9+PTX
DATA_DIR=/home/songlin/workspace/projects/SIMPLE/data
# docker proxy (used for building docker image)
PROXY=http://192.168.0.69:7890
DISPLAY=":1"
DATE=251025
MUJOCO_GL=egl

# Teleop capture -> Hugging Face pipeline (see docs/source/tutorials/teleop_hf_pipeline.md)
# Classic HF token with WRITE access to all three repos below. Never commit this file with a real token filled in.
HF_TOKEN=
HF_REPO_RAW=USC-PSI-Lab/simple-teleop-raw
HF_REPO_RENDERED=USC-PSI-Lab/simple-teleop-rendered
# Consolidated psi0-format training corpus, rebuilt from HF_REPO_RENDERED by sync-and-render.
HF_REPO_PSI0=USC-PSI-Lab/simple-teleop-psi0
# Your name, embedded in captured session paths/metadata (used by teleop-decoupled-wbc --record).
SIMPLE_OPERATOR=