#usda 1.0
(
    defaultPrim = "pad_blue"
    metersPerUnit = 1
    upAxis = "Z"
)

# Flat colour ZONE marker (see pad_red.usda).
def Xform "pad_blue"
{
    def Cube "geom"
    {
        double size = 1
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        color3f[] primvars:displayColor = [(0.02, 0.08, 0.90)]
        double3 xformOp:scale = (0.18, 0.18, 0.004)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }
}
